# INTECARE 2026 — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust variables to override defaults

# Database Credentials (Defaults to local XAMPP MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=intecare
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Email Dispatch via SMTP (Optional for local testing; simulated logging when false)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=awards@intecare.org
MAIL_FROM_NAME=INTECARE 2026 Secretariat
